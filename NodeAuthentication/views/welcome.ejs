<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard</title>
  <link rel="stylesheet" href="/styles.css" />
  <style>
    /* ====== DASHBOARD STYLING ====== */

    body {
      font-family: "Poppins", sans-serif;
      background-color: #f8f9fa;
      margin: 0;
      padding: 0;
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* Sidebar */
    .sidebar {
      width: 220px;
      background-color: #1e62a6;
      color: #fff;
      display: flex;
      flex-direction: column;
      padding-top: 30px;
      transition: all 0.3s ease;
    }

    .sidebar a {
      color: #fff;
      text-decoration: none;
      padding: 14px 25px;
      display: block;
      font-weight: 500;
    }

    .sidebar a:hover {
      background-color: #114b85;
      border-left: 4px solid #ffa500;
    }

    /* Main Content */
    .main-content {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      height: 100vh;
    }

    /* Top Navbar */
    .navbar {
      background-color: #f37021;
      color: white;
      padding: 15px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
    }

    .navbar .menu {
      display: flex;
      gap: 25px;
    }

    .navbar .menu a {
      color: white;
      text-decoration: none;
      font-weight: 500;
    }

    .navbar .menu a:hover {
      text-decoration: underline;
    }

    /* Dashboard Cards Section */
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      padding: 25px;
      background-color: #fff;
      flex-grow: 1;
      overflow-y: auto;
    }

    .card {
      background-color: #e9ecef;
      border-radius: 10px;
      padding: 20px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .card h3 {
      margin-top: 0;
      color: #333;
    }

    .card p {
      color: #555;
      font-size: 14px;
    }

    /* Buttons / Theme */
    .dark-theme {
      background-color: #222;
      color: #fff;
    }
  </style>
</head>

<body>
  <!-- Sidebar -->
  <div class="sidebar">
    <a href="#">Dashboard</a>
    <a href="#">Revenue</a>
    <a href="#">Sales</a>
    <a href="#">Customers</a>
    <a href="#">Reports</a>
    <a href="#">Meetings</a>
    <a href="#">Events</a>
    <a href="#">Settings</a>
  </div>

  <!-- Main Content -->
  <div class="main-content">
    <!-- Navbar -->
    <div class="navbar">
      <div class="menu">
        <a href="#">Company</a>
        <a href="#">Revenue</a>
        <a href="#">Sales</a>
        <a href="#">Customers</a>
        <a href="#">Reports</a>
        <a href="#">Settings</a>
      </div>
      <div class="menu">
        <a href="#" id="dark-toggle">Dark Theme</a>
        <a href="/login">Logout</a>
      </div>
    </div>

    <!-- Dashboard Content -->
    <div class="cards">
      <div class="card">
        <h3>Revenue</h3>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
      </div>

      <div class="card">
        <h3>Sales</h3>
        <p>Ut euismod efficitur turpis, non tincidunt nibh volutpat sed.</p>
      </div>

      <div class="card">
        <h3>Customers</h3>
        <p>Suspendisse semper ipsum eget neque malesuada auctor.</p>
      </div>

      <div class="card">
        <h3>Reports</h3>
        <p>Morbi id feugiat mauris, at tempus mi.</p>
      </div>

      <div class="card">
        <h3>Meetings</h3>
        <p>Vestibulum vitae eros nec lectus posuere ultricies.</p>
      </div>

      <div class="card">
        <h3>Events</h3>
        <p>Maecenas ultrices dapibus non vitae nulla.</p>
      </div>
    </div>
  </div>

  <script>
    // Toggle Dark Theme
    const toggle = document.getElementById('dark-toggle');
    toggle.addEventListener('click', () => {
      document.body.classList.toggle('dark-theme');
    });
  </script>
</body>
</html>
